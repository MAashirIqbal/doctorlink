NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/doctorlink

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=30d

# Stripe (test mode keys are fine for development)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Allowed web origin(s), comma-separated. Also used for Stripe return URLs.
CLIENT_URL=http://localhost:5173

# Required only for the symptom analyser feature
ANTHROPIC_API_KEY=your_api_key
